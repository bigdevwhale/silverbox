    <!-- Onboarding -->
    <string name="onb1_title">Shoot now.\nSee tomorrow.</string>
    <string name="onb1_text">Silverbox is a film camera for the family. You shoot with your phone\'s own camera, the pictures go on a roll of film, and you won\'t see them until the lab develops it. Fewer pictures, more moments.</string>
    <string name="onb2_title">How a roll goes round</string>
    <string name="onb2_s1">Load a roll: 24 or 36 frames of the film you like</string>
    <string name="onb2_s2">Shoot with your phone\'s camera, in any mode it has</string>
    <string name="onb2_s3">When the roll is done, hand it in at the lab</string>
    <string name="onb2_s4">A day later, open the envelope of prints</string>
    <string name="onb3_title">One permission</string>
    <string name="onb3_text">To put your camera\'s pictures on the film, Silverbox needs to see your photos and videos. Nothing ever leaves the phone.</string>
    <string name="onb3_allow">Allow access</string>
    <string name="onb3_allowed">Access granted. You\'re all set.</string>
    <string name="onb_start">Load the first roll</string>

